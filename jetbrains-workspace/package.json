{
  "name": "dsh-jetbrains-workspace",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "description": "Reads the current JetBrains IDE workspace (root and attached project directories) into DSH, and opens files in the IDE.",
  "license": "MIT",
  "author": "abadi gilang <gilang@binokular.net>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abadiegie/dsh-jetbrains.git",
    "directory": "jetbrains-workspace"
  },
  "homepage": "https://github.com/abadiegie/dsh-jetbrains/tree/main/jetbrains-workspace#readme",
  "bugs": "https://github.com/abadiegie/dsh-jetbrains/issues",
  "exports": {
    ".": "./src/plugin.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "src/*.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
